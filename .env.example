# PostgreSQL (same DB as former Node/Prisma chat-server)
CHAT_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Admin API key — must match rtechnical CHAT_ADMIN_API_KEY
CHAT_ADMIN_API_KEY=generate-a-long-random-string

# Comma-separated origins (Next.js site + local dev)
CORS_ORIGIN=http://localhost:3000,https://rtechnical.com.vn,https://www.rtechnical.com.vn

# Optional: redis for multi-process Action Cable (default async is fine on Render single instance)
# ACTION_CABLE_ADAPTER=redis
# REDIS_URL=redis://...

PORT=3002
RAILS_ENV=development
